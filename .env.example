# Copia este archivo a .env.local y pega los valores de tu proyecto
# en Supabase → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# En proyectos nuevos, Supabase muestra una "publishable key".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_reemplaza_esto

# Si tu proyecto todavía muestra la "anon / public" key (JWT),
# puedes usarla en su lugar (el código acepta cualquiera de las dos):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# URL pública del sitio. En local puedes dejarla vacía.
# En Vercel se usa para armar links de invitación si hace falta.
# NEXT_PUBLIC_SITE_URL=https://vibekathon.com

# Solo para `npm run test:rls` (nunca la subas a GitHub).
# Supabase → Project Settings → API → service_role
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
